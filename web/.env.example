# Copy to .env.local and fill in. Never commit .env.local.

# A PayPal sandbox app (Merchant) on a US sandbox business account, with
# Payouts, Invoicing and Transaction search ticked under Features.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
# Sandbox personal accounts: who receives payouts, and who gets invoices.
PAYPAL_FREELANCER_EMAIL=
PAYPAL_CLIENT_EMAIL=

# Gemini API key (aistudio.google.com).
AI_API_KEY=
# Optional fallback when Gemini is out of quota (tokenfactory.nebius.com).
NEBIUS_API_KEY=

# Optional: Elastic for Brain search (switch it on in Brain > Search).
# ELASTIC_URL=https://<deployment>.es.<region>.cloud.es.io
# ELASTIC_API_KEY=
# Optional: read-only token for private GitHub repos.
# GITHUB_TOKEN=
# NEBIUS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Production only.
# ENGINE_DOER_TOKEN=
# ENGINE_SHOW_DOER_TOKEN=1
# ENGINE_OWNER_KEY=
# CRON_SECRET=
# DATA_DIR=/var/data
